<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#050504">
  <meta name="description" content="HUYDJI MEDIA — cinematic visual portfolio, bất động sản, sự kiện, flycam và trải nghiệm 360°.">
  <title>HUYDJI MEDIA | Cinematic Visual Portfolio</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="https://cdn.pannellum.org/2.5/pannellum.css">
  <script src="https://cdn.pannellum.org/2.5/pannellum.js"></script>

  <style>
    :root{
      --bg:#050504;
      --bg2:#0b0907;
      --ink:#f6f3eb;
      --muted:#979187;
      --gold:#c99f54;
      --gold2:#f0d49a;
      --line:rgba(240,212,154,.16);
      --panel:rgba(255,255,255,.035);
      --ease:cubic-bezier(.2,.78,.18,1);
      --max:1460px;
      --mx:50vw;
      --my:50vh;
    }

    *{box-sizing:border-box}
    html{scroll-behavior:smooth;background:var(--bg)}
    body{
      margin:0;
      background:var(--bg);
      color:var(--ink);
      font-family:Manrope,Arial,sans-serif;
      overflow-x:hidden
    }
    body.loading{overflow:hidden}
    a{color:inherit;text-decoration:none}
    button{font:inherit;color:inherit}
    img,video{display:block;width:100%}
    ::selection{background:var(--gold2);color:#090704}

    .shell{
      width:min(var(--max),calc(100% - 84px));
      margin:0 auto;
      position:relative;
      z-index:3
    }

    .gold{color:var(--gold2)}

    .eyebrow{
      font-size:9px;
      letter-spacing:.5em;
      text-transform:uppercase;
      color:#e7c57e;
      font-weight:700;
      animation:eyebrowPulse 4.8s ease-in-out infinite
    }

    .section{
      padding:145px 0;
      position:relative
    }

    #progress{
      position:fixed;
      z-index:10020;
      left:0;
      top:0;
      width:0;
      height:2px;
      background:linear-gradient(90deg,#805820,var(--gold2));
      box-shadow:0 0 26px rgba(240,212,154,.35)
    }

    .noise{
      position:fixed;
      inset:0;
      z-index:9990;
      pointer-events:none;
      opacity:.03;
      mix-blend-mode:soft-light;
      background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 160 160' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.86' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E")
    }

    .mouse-glow{
      position:fixed;
      inset:0;
      z-index:1;
      pointer-events:none;
      background:
        radial-gradient(
          480px circle at var(--mx) var(--my),
          rgba(220,175,92,.075),
          transparent 62%
        )
    }

    #ambient{
      position:fixed;
      inset:0;
      z-index:1;
      pointer-events:none;
      opacity:.45
    }

    .cursor-dot,
    .cursor-ring{
      position:fixed;
      left:0;
      top:0;
      z-index:10030;
      pointer-events:none;
      border-radius:50%;
      opacity:0;
      transition:opacity .2s ease
    }

    .cursor-dot{
      width:5px;
      height:5px;
      margin:-2.5px 0 0 -2.5px;
      background:var(--gold2)
    }

    .cursor-ring{
      width:38px;
      height:38px;
      margin:-19px 0 0 -19px;
      border:1px solid rgba(240,212,154,.52);
      transition:
        width .3s var(--ease),
        height .3s var(--ease),
        margin .3s var(--ease),
        background .3s ease
    }

    body.cursor-on .cursor-dot,
    body.cursor-on .cursor-ring{
      opacity:1
    }

    body.cursor-hover .cursor-ring{
      width:62px;
      height:62px;
      margin:-31px 0 0 -31px;
      background:rgba(240,212,154,.055)
    }

    .loader{
      position:fixed;
      inset:0;
      z-index:11000;
      background:#050504;
      display:grid;
      place-items:center;
      transition:
        opacity .8s var(--ease),
        visibility .8s var(--ease)
    }

    .loader.off{
      opacity:0;
      visibility:hidden
    }

    .loader-box{text-align:center}

    .loader-logo{
      font-family:Montserrat,sans-serif;
      font-weight:700;
      font-size:clamp(42px,7vw,100px);
      letter-spacing:.06em
    }

    .loader-logo span{color:var(--gold2)}

    .loader-sub{
      margin-top:10px;
      color:#827766;
      font-size:8px;
      letter-spacing:.5em;
      text-transform:uppercase
    }

    .loader-line{
      width:190px;
      height:1px;
      background:#251e14;
      margin:26px auto 0;
      overflow:hidden
    }

    .loader-line i{
      display:block;
      width:40%;
      height:100%;
      background:
        linear-gradient(
          90deg,
          transparent,
          var(--gold2),
          transparent
        );
      animation:loaderLine 1.1s infinite
    }

    header{
      position:fixed;
      z-index:9500;
      top:0;
      left:0;
      right:0;
      height:82px;
      background:
        linear-gradient(
          180deg,
          rgba(5,5,4,.94),
          rgba(5,5,4,.58)
        );
      border-bottom:1px solid rgba(255,255,255,.055);
      backdrop-filter:blur(18px);
      -webkit-backdrop-filter:blur(18px);
      transition:
        transform .45s var(--ease),
        background .35s ease
    }

    header.hide{transform:translateY(-100%)}
    header.scrolled{background:rgba(5,5,4,.86)}

    .nav{
      height:100%;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:30px
    }

    .brand{
      display:flex;
      flex-direction:column;
      gap:3px
    }

    .brand strong{
      font-family:Montserrat,sans-serif;
      font-size:21px;
      letter-spacing:.24em;
      font-weight:700
    }

    .brand strong span{
      background:
        linear-gradient(
          90deg,
          #9d6e2e,
          #f1d79f,
          #b87e35,
          #f7e2b4
        );
      background-size:240% 100%;
      -webkit-background-clip:text;
      background-clip:text;
      color:transparent;
      animation:goldFlow 7s ease-in-out infinite
    }

    .brand small{
      font-size:7px;
      letter-spacing:.42em;
      color:#6f695f;
      text-transform:uppercase
    }

    nav{
      display:flex;
      gap:30px;
      align-items:center
    }

    nav a{
      font-size:9px;
      letter-spacing:.18em;
      text-transform:uppercase;
      color:#aaa69e;
      position:relative;
      padding:30px 0
    }

    nav a:after{
      content:"";
      position:absolute;
      left:50%;
      bottom:21px;
      width:0;
      height:1px;
      background:var(--gold2);
      transform:translateX(-50%);
      transition:.35s var(--ease)
    }

    nav a:hover{color:#fff}
    nav a:hover:after{width:100%}

    .menu-btn{
      display:none;
      width:46px;
      height:46px;
      background:transparent;
      border:0;
      cursor:pointer
    }

    .menu-btn span,
    .menu-btn:before,
    .menu-btn:after{
      content:"";
      display:block;
      width:24px;
      height:1px;
      background:#fff;
      margin:6px auto;
      transition:.3s
    }

    .mobile-panel{
      position:fixed;
      z-index:9400;
      inset:0;
      background:rgba(5,5,4,.985);
      display:grid;
      place-items:center;
      opacity:0;
      visibility:hidden;
      transition:.4s var(--ease)
    }

    .mobile-panel.open{
      opacity:1;
      visibility:visible
    }

    .mobile-panel nav{
      display:flex;
      flex-direction:column;
      gap:10px
    }

    .mobile-panel nav a{
      font-family:Montserrat,sans-serif;
      font-size:36px;
      letter-spacing:-.03em;
      text-transform:none;
      padding:8px
    }

    .hero{
      position:relative;
      min-height:100svh;
      display:flex;
      align-items:flex-end;
      overflow:hidden;
      background:#050504
    }

    .hero-fallback,
    .hero-video{
      position:absolute;
      inset:-4%;
      width:108%;
      height:108%;
      object-fit:cover
    }

    .hero-fallback{
      background-image:
        linear-gradient(
          180deg,
          rgba(5,5,4,.15),
          rgba(5,5,4,.88)
        ),
        url('./images/media-bg.jpg');
      background-size:cover;
      background-position:center
    }

    .hero-video{
      opacity:.45;
      filter:saturate(.72) contrast(1.12) brightness(.76);
      animation:heroBreath 16s ease-in-out infinite alternate
    }

    .hero-overlay{
      position:absolute;
      inset:0;
      background:
        linear-gradient(
          180deg,
          rgba(5,5,4,.12),
          rgba(5,5,4,.12) 42%,
          rgba(5,5,4,.96)
        ),
        linear-gradient(
          90deg,
          rgba(5,5,4,.54),
          transparent 55%,
          rgba(5,5,4,.18)
        )
    }

    .hero-orbit{
      position:absolute;
      z-index:1;
      width:min(72vw,1040px);
      aspect-ratio:1;
      border:1px solid rgba(240,212,154,.085);
      border-radius:50%;
      left:52%;
      top:51%;
      transform:translate(-50%,-48%);
      box-shadow:
        0 0 150px rgba(214,177,106,.045),
        inset 0 0 190px rgba(214,177,106,.025)
    }

    .hero-orbit:before,
    .hero-orbit:after{
      content:"";
      position:absolute;
      border-radius:50%;
      inset:8%;
      border:1px solid rgba(255,255,255,.025)
    }

    .hero-orbit:after{
      inset:18%;
      border-color:rgba(240,212,154,.05)
    }

    .light-sweep{
      position:absolute;
      z-index:1;
      top:-20%;
      left:-40%;
      width:34%;
      height:150%;
      background:
        linear-gradient(
          90deg,
          transparent,
          rgba(240,212,154,.055),
          transparent
        );
      transform:rotate(16deg);
      animation:sweep 11s ease-in-out infinite
    }

    .hero-content{
      position:relative;
      z-index:3;
      width:100%;
      padding:175px 0 58px
    }

    .hero-grid{
      display:grid;
      grid-template-columns:1.2fr .8fr;
      gap:68px;
      align-items:end
    }

    .hero h1{
      font-family:Montserrat,sans-serif;
      font-size:clamp(70px,9.2vw,150px);
      font-weight:650;
      line-height:.91;
      letter-spacing:-.055em;
      margin:22px 0 36px;
      max-width:100%
    }

    .hero h1 .line{
      display:block;
      overflow:hidden;
      padding-right:.08em;
      padding-bottom:.06em
    }

    .hero h1 .line+.line{
      margin-top:clamp(22px,1.8vw,34px)
    }

    .hero h1 .line i{
      display:block;
      font-style:normal;
      transform:translateY(110%);
      background-size:320% 100%;
      -webkit-background-clip:text;
      background-clip:text;
      color:transparent;
      animation-name:titleUp,luxTextFlow;
      animation-duration:1.05s,10s;
      animation-timing-function:var(--ease),ease-in-out;
      animation-fill-mode:forwards,none;
      animation-iteration-count:1,infinite
    }

    .hero h1 .line:first-child i{
      background-image:
        linear-gradient(
          105deg,
          #f8f5ee 0%,
          #fff 22%,
          #d7c7a5 38%,
          #fff 52%,
          #d9b974 65%,
          #f8f4eb 82%,
          #fff 100%
        )
    }

    .hero h1 .line:nth-child(2) i{
      background-image:
        linear-gradient(
          105deg,
          #8d622b 0%,
          #d5aa61 18%,
          #fff0c9 34%,
          #b37d36 50%,
          #f6dda7 68%,
          #c49348 82%,
          #f4d697 100%
        );
      animation-delay:.13s,0s
    }

    .hero-copy{
      max-width:650px;
      color:#aaa59b;
      font-size:13px;
      line-height:1.95
    }

    .hero-side p{
      font-family:Montserrat,sans-serif;
      font-size:clamp(28px,3.2vw,50px);
      line-height:1.16;
      margin:0 0 30px;
      color:#ded8cc;
      font-weight:500
    }

    .cta-row{
      display:flex;
      gap:12px;
      flex-wrap:wrap
    }

    .btn{
      position:relative;
      overflow:hidden;
      display:inline-flex;
      align-items:center;
      gap:14px;
      border:1px solid rgba(214,177,106,.34);
      padding:20px 30px;
      font-size:11px;
      letter-spacing:.24em;
      text-transform:uppercase;
      background:rgba(255,255,255,.01);
      transition:.4s var(--ease)
    }

    .btn:before{
      content:"";
      position:absolute;
      inset:0;
      background:
        linear-gradient(
          110deg,
          rgba(240,212,154,.14),
          transparent 60%
        );
      transform:translateX(-105%);
      transition:.55s var(--ease)
    }

    .btn:hover:before{transform:none}

    .btn:hover{
      transform:translateY(-3px);
      border-color:rgba(240,212,154,.75);
      box-shadow:0 18px 48px rgba(0,0,0,.28)
    }

    .btn.primary{
      background:
        linear-gradient(
          110deg,
          #93672c,
          #e0b66b
        );
      color:#0b0906;
      border-color:transparent;
      font-weight:800
    }

    .hero-tags{
      margin-top:70px;
      display:grid;
      grid-template-columns:repeat(4,1fr);
      border:1px solid rgba(255,255,255,.07);
      background:rgba(5,5,4,.35);
      backdrop-filter:blur(12px)
    }

    .hero-tag{
      padding:25px 28px;
      border-right:1px solid rgba(255,255,255,.07)
    }

    .hero-tag:last-child{border:0}

    .hero-tag b{
      display:block;
      font-family:Montserrat,sans-serif;
      color:var(--gold2);
      font-size:21px;
      font-weight:600
    }

    .hero-tag small{
      display:block;
      margin-top:7px;
      color:#726e67;
      font-size:7px;
      letter-spacing:.2em;
      text-transform:uppercase
    }

    .scroll-cue{
      position:absolute;
      z-index:3;
      right:42px;
      bottom:38px;
      display:flex;
      align-items:center;
      gap:12px;
      transform:rotate(90deg);
      transform-origin:right bottom;
      color:#746f66;
      font-size:7px;
      letter-spacing:.22em;
      text-transform:uppercase
    }

    .scroll-cue i{
      width:54px;
      height:1px;
      background:
        linear-gradient(
          90deg,
          var(--gold),
          transparent
        )
    }

    .marquee{
      position:relative;
      z-index:4;
      overflow:hidden;
      border-top:1px solid rgba(255,255,255,.055);
      border-bottom:1px solid rgba(255,255,255,.055);
      background:#070706
    }

    .marquee:before,
    .marquee:after{
      content:"";
      position:absolute;
      z-index:2;
      top:0;
      bottom:0;
      width:120px;
      pointer-events:none
    }

    .marquee:before{
      left:0;
      background:linear-gradient(90deg,#070706,transparent)
    }

    .marquee:after{
      right:0;
      background:linear-gradient(-90deg,#070706,transparent)
    }

    .marquee-track{
      display:flex;
      width:max-content;
      animation:marquee 22s linear infinite;
      will-change:transform
    }

    .marquee-group{
      flex:0 0 auto;
      padding:23px 0
    }

    .marquee span{
      font-family:Montserrat,sans-serif;
      font-size:17px;
      letter-spacing:.18em;
      color:#8e887f;
      white-space:nowrap
    }

    .marquee b{
      color:var(--gold2);
      font-weight:600
    }

    .section-head{
      display:grid;
      grid-template-columns:1.2fr .8fr;
      gap:70px;
      align-items:end;
      margin-bottom:58px
    }

    .section-title{
      font-family:Montserrat,sans-serif;
      font-size:clamp(48px,5.3vw,86px);
      line-height:1.08;
      letter-spacing:-.04em;
      margin:16px 0 0;
      font-weight:600
    }

    .section-desc{
      max-width:560px;
      justify-self:end;
      color:#98938a;
      font-size:12px;
      line-height:1.9
    }

    .section-title .gold,
    .story-title .gold,
    .team-title .gold,
    .contact-title .gold{
      background-image:
        linear-gradient(
          105deg,
          #8d622b 0%,
          #d5aa61 18%,
          #fff0c9 34%,
          #b37d36 50%,
          #f6dda7 68%,
          #c49348 82%,
          #f4d697 100%
        );
      background-size:340% 100%;
      -webkit-background-clip:text;
      background-clip:text;
      color:transparent;
      animation:goldFlow 8.5s ease-in-out infinite
    }

    .reveal{
      opacity:0;
      transform:translateY(34px);
      filter:blur(6px);
      transition:
        opacity .9s var(--ease),
        transform .9s var(--ease),
        filter 1s var(--ease)
    }

    .reveal.in{
      opacity:1;
      transform:none;
      filter:blur(0)
    }

    .clip{
      clip-path:inset(0 0 100% 0);
      transform:scale(1.04);
      transition:
        clip-path 1.15s var(--ease),
        transform 1.35s var(--ease)
    }

    .clip.in{
      clip-path:inset(0);
      transform:none
    }

    .parallax{will-change:transform}

    .story{
      background:
        linear-gradient(
          180deg,
          #060605,
          #0a0907
        )
    }

    .story-layout{
      display:grid;
      grid-template-columns:.8fr 1.2fr;
      gap:78px;
      align-items:start
    }

    .story-copy{
      position:sticky;
      top:145px;
      padding:30px 0 80px
    }

    .story-title{
      font-family:Montserrat,sans-serif;
      font-size:clamp(50px,5.5vw,84px);
      line-height:1.12;
      letter-spacing:-.04em;
      margin:22px 0 38px;
      font-weight:600
    }

    .story-title span{
      display:block;
      background-size:320% 100%;
      -webkit-background-clip:text;
      background-clip:text;
      color:transparent;
      animation:luxTextFlow 10s ease-in-out infinite
    }

    .story-title span:first-child{
      background-image:
        linear-gradient(
          105deg,
          #f7f4ed 0%,
          #fffdf8 20%,
          #d9c9a7 36%,
          #fff 50%,
          #d8b873 62%,
          #f8f4eb 78%,
          #fff 100%
        )
    }

    .story-title .gold{
      margin-top:.24em
    }

    .story-copy p{
      max-width:540px;
      color:#99948a;
      line-height:1.95;
      font-size:12px
    }

    .story-stack{
      display:grid;
      gap:22px
    }

    .story-media{
      position:relative;
      min-height:650px;
      overflow:hidden;
      border:1px solid rgba(214,177,106,.14);
      background:
        radial-gradient(
          circle at 62% 40%,
          rgba(214,177,106,.14),
          transparent 30%
        ),
        linear-gradient(
          135deg,
          #15120d,
          #080706 60%
        )
    }

    .story-media.tall{
      min-height:820px
    }

    .story-media img{
      position:absolute;
      inset:0;
      height:112%;
      object-fit:cover;
      opacity:.9;
      top:-6%;
      transition:
        transform 1.2s var(--ease),
        filter 1s ease
    }

    .story-media:hover img{
      transform:scale(1.04);
      filter:saturate(.95)
    }

    .story-media:after{
      content:"";
      position:absolute;
      inset:0;
      background:
        linear-gradient(
          180deg,
          transparent 48%,
          rgba(5,5,4,.72)
        )
    }

    .story-index{
      position:absolute;
      z-index:2;
      left:24px;
      bottom:21px;
      font-size:8px;
      letter-spacing:.24em;
      color:var(--gold2)
    }

    .projects{background:#070706}

    .project-grid{
      display:grid;
      grid-template-columns:repeat(12,1fr);
      gap:18px
    }

    .project-card{
      position:relative;
      overflow:hidden;
      border:1px solid rgba(255,255,255,.075);
      background:
        radial-gradient(
          circle at 70% 30%,
          rgba(214,177,106,.16),
          transparent 28%
        ),
        linear-gradient(
          135deg,
          #17140e,
          #090807 60%
        );
      cursor:pointer;
      transform-style:preserve-3d;
      transition:
        border-color .4s ease,
        box-shadow .5s ease
    }

    .project-card:nth-child(1){
      grid-column:span 7;
      aspect-ratio:16/9
    }

    .project-card:nth-child(2){
      grid-column:span 5;
      aspect-ratio:16/11
    }

    .project-card:nth-child(3){
      grid-column:3/span 8;
      aspect-ratio:16/9;
      margin-top:12px
    }

    .project-card:before{
      content:"";
      position:absolute;
      inset:-1px;
      z-index:1;
      background:
        linear-gradient(
          115deg,
          transparent 30%,
          rgba(240,212,154,.18),
          transparent 70%
        );
      transform:translateX(-120%);
      transition:transform 1s var(--ease);
      pointer-events:none
    }

    .project-card:hover:before{
      transform:translateX(120%)
    }

