  <script>
    const $ = (s,scope=document) => scope.querySelector(s);
    const $$ = (s,scope=document) => [...scope.querySelectorAll(s)];

    const reduce =
      matchMedia('(prefers-reduced-motion: reduce)').matches;


    window.addEventListener('load', () => {

      setTimeout(() => {

        $('#loader').classList.add('off');

        document.body.classList.remove('loading');

      },450);

    });


    const io =
      new IntersectionObserver(
        entries => {

          entries.forEach(entry => {

            if(entry.isIntersecting){

              entry.target.classList.add('in');

              io.unobserve(entry.target);

            }

          });

        },
        {
          threshold:.1,
          rootMargin:'0px 0px -7%'
        }
      );


    $$('.reveal,.clip')
      .forEach(el => io.observe(el));


    let lastY = 0;

    let ticking = false;


    function scrollFx(){

      if(ticking)return;

      ticking = true;


      requestAnimationFrame(() => {

        const y = scrollY;

        const max =
          document.documentElement.scrollHeight
          -
          innerHeight;


        $('#progress').style.width =
          (max ? y / max * 100 : 0)
          +
          '%';


        const header = $('#header');


        header.classList.toggle(
          'scrolled',
          y > 40
        );


        header.classList.toggle(
          'hide',
          y > 180
          &&
          y > lastY + 3
        );


        lastY = y;


        if(!reduce){

          $$('.parallax')
            .forEach(el => {

              const r =
                el.getBoundingClientRect();


              const speed =
                parseFloat(
                  el.dataset.speed || 0
                );


              el.style.transform =
                `translate3d(
                  0,
                  ${(innerHeight*.5-r.top)*speed}px,
                  0
                )`;

            });

        }


        ticking = false;

      });

    }


    addEventListener(
      'scroll',
      scrollFx,
      {passive:true}
    );


    scrollFx();


    if(
      matchMedia('(pointer:fine)').matches
    ){

      document.body
        .classList
        .add('cursor-on');


      const dot =
        $('.cursor-dot');


      const ring =
        $('.cursor-ring');


      let mx = 0;

      let my = 0;

      let rx = 0;

      let ry = 0;


      addEventListener(
        'mousemove',
        e => {

          mx = e.clientX;

          my = e.clientY;


          dot.style.transform =
            `translate(
              ${mx}px,
              ${my}px
            )`;


          document
            .documentElement
            .style
            .setProperty(
              '--mx',
              mx + 'px'
            );


          document
            .documentElement
            .style
            .setProperty(
              '--my',
              my + 'px'
            );

        }
      );


      (
        function cursorLoop(){

          rx += (mx-rx)*.16;

          ry += (my-ry)*.16;


          ring.style.transform =
            `translate(
              ${rx}px,
              ${ry}px
            )`;


          requestAnimationFrame(
            cursorLoop
          );

        }
      )();


      $$('a,button,.tilt')
        .forEach(el => {

          el.addEventListener(
            'mouseenter',
            () =>
              document.body
                .classList
                .add('cursor-hover')
          );


          el.addEventListener(
            'mouseleave',
            () =>
              document.body
                .classList
                .remove('cursor-hover')
          );

        });

    }


    if(
      matchMedia('(pointer:fine)').matches
      &&
      !reduce
    ){

      $$('.magnetic')
        .forEach(el => {

          el.addEventListener(
            'mousemove',
            e => {

              const r =
                el.getBoundingClientRect();


              const x =
                e.clientX
                -
                r.left
                -
                r.width/2;


              const y =
                e.clientY
                -
                r.top
                -
                r.height/2;


              el.style.transform =
                `translate(
                  ${x*.12}px,
                  ${y*.12}px
                )`;

            }
          );


          el.addEventListener(
            'mouseleave',
            () =>
              el.style.transform = ''
          );

        });


      $$('.tilt')
        .forEach(el => {

          el.addEventListener(
            'mousemove',
            e => {

              const r =
                el.getBoundingClientRect();


              const x =
                (
                  e.clientX
                  -
                  r.left
                )
                /
                r.width
                -
                .5;


              const y =
                (
                  e.clientY
                  -
                  r.top
                )
                /
                r.height
                -
                .5;


              el.style.transform =
                `perspective(900px)
                 rotateX(${-y*4}deg)
                 rotateY(${x*5}deg)
                 translateY(-3px)`;

            }
          );


          el.addEventListener(
            'mouseleave',
            () =>
              el.style.transform = ''
          );

        });


      $$('.contact-link')
        .forEach(el => {

          el.addEventListener(
            'mousemove',
            e => {

              const r =
                el.getBoundingClientRect();


              el.style.setProperty(
                '--sx',
                (
                  (
                    e.clientX
                    -
                    r.left
                  )
                  /
                  r.width
                  *
                  100
                ).toFixed(1)
                +
                '%'
              );


              el.style.setProperty(
                '--sy',
                (
                  (
                    e.clientY
                    -
                    r.top
                  )
                  /
                  r.height
                  *
                  100
                ).toFixed(1)
                +
                '%'
              );

            }
          );

        });

    }


    const menuBtn =
      $('#menuBtn');


    const mobilePanel =
      $('#mobilePanel');


    menuBtn.addEventListener(
      'click',
      () =>
        mobilePanel
          .classList
          .toggle('open')
    );


    $$('a',mobilePanel)
      .forEach(a => {

        a.addEventListener(
          'click',
          () =>
            mobilePanel
              .classList
              .remove('open')
        );

      });


    $$('.project-card')
      .forEach(card => {

        const v =
          $('video',card);


        if(!v)return;


        card.addEventListener(
          'mouseenter',
          () =>
            v.play()
             .catch(()=>{})
        );


        card.addEventListener(
          'mouseleave',
          () => {

            v.pause();


            try{

              v.currentTime = 0;

            }
            catch(e){}

          }
        );

      });


    const music =
      $('#bgMusic');


    const soundBtn =
      $('#soundBtn');


    const soundLabel =
      $('.sound-label',soundBtn);


    music.volume = .22;


    function soundState(on){

      soundBtn
        .classList
        .toggle(
          'playing',
          on
        );


      soundLabel.textContent =
        on
        ?
        'Sound on · click to mute'
        :
        'Sound off · click to play';

    }


    async function startMusic(){

      if(!music.paused){

        soundState(true);

        return true;

      }


      try{

        await music.play();

        soundState(true);

        return true;

      }
      catch(e){

        soundState(false);

        return false;

      }

    }


    soundBtn.addEventListener(
      'click',
      e => {

        e.stopPropagation();


        if(music.paused){

          startMusic();

        }
        else{

          music.pause();

          soundState(false);

        }

      }
    );


    setTimeout(
      () =>
        startMusic(),
      800
    );


    function unlockMusic(e){

      if(
        e.target
        ?.
        closest
        ?.
        ('#soundBtn')
      ){
        return;
      }


      startMusic();


      document.removeEventListener(
        'pointerdown',
        unlockMusic
      );


      document.removeEventListener(
        'touchstart',
        unlockMusic
      );


      document.removeEventListener(
        'keydown',
        unlockMusic
      );

    }


    document.addEventListener(
      'pointerdown',
      unlockMusic,
      {passive:true}
    );


    document.addEventListener(
      'touchstart',
      unlockMusic,
      {passive:true}
    );


    document.addEventListener(
      'keydown',
      unlockMusic
    );


    music.addEventListener(
      'error',
      () => {

        soundLabel.textContent =
          'Music file missing';


        soundBtn
          .classList
          .remove('playing');

      }
    );


    (
      function init360(){

        if(
          typeof pannellum
          ===
          'undefined'
        ){
          return;
        }


        const image =
          './images/panorama-360.jpg';


        const test =
          new Image();


        test.onload =
          () => {

            $('#panoFallback')
              .style
              .display =
              'none';


            pannellum.viewer(
              'panorama360',
              {

                type:
                  'equirectangular',

                panorama:
                  image,

                autoLoad:
                  true,

                showControls:
                  true,

                showFullscreenCtrl:
                  true,

                showZoomCtrl:
                  true,

                mouseZoom:
                  true,

                draggable:
                  true,

                pitch:
                  0,

                yaw:
                  0,

                hfov:
                  100,

                minHfov:
                  50,

                maxHfov:
                  120,

                autoRotate:
                  -.8,

                autoRotateInactivityDelay:
                  3800,

                compass:
                  false

              }
            );

          };


        test.src =
          image;

      }
    )();


    if(!reduce){

      const canvas =
        $('#ambient');


      const ctx =
        canvas.getContext('2d');


      let w = 0;

      let h = 0;

      let dpr = 1;

      let pts = [];


      function resize(){

        dpr =
          Math.min(
            devicePixelRatio || 1,
            2
          );


        w =
          innerWidth;


        h =
          innerHeight;


        canvas.width =
          w * dpr;


        canvas.height =
          h * dpr;


        canvas.style.width =
          w + 'px';


        canvas.style.height =
          h + 'px';


        ctx.setTransform(
          dpr,
          0,
          0,
          dpr,
          0,
          0
        );


        pts =
          Array.from(
            {
              length:
                Math.min(
                  48,
                  Math.floor(w/32)
                )
            },
            () => ({
              x:
                Math.random()*w,

              y:
                Math.random()*h,

              r:
                Math.random()*1.1
                +
                .25,

              v:
                Math.random()*.14
                +
                .035,

              a:
                Math.random()*.28
                +
                .05
            })
          );

      }


      function draw(){

        ctx.clearRect(
          0,
          0,
          w,
          h
        );


        for(
          const p
          of
          pts
        ){

          p.y -= p.v;


          if(
            p.y
            <
            -4
          ){

            p.y =
              h + 4;


            p.x =
              Math.random()*w;

          }


          ctx.beginPath();


          ctx.fillStyle =
            `rgba(
              240,
              212,
              154,
              ${p.a}
            )`;


          ctx.arc(
            p.x,
            p.y,
            p.r,
            0,
            Math.PI*2
          );


          ctx.fill();

        }


        requestAnimationFrame(
          draw
        );

      }


      addEventListener(
        'resize',
        resize
      );


      resize();

      draw();

    }
  </script>

</body>
</html>
